# Path A (default): everything on Studio — CDP is local Chrome.
CDP_URL=http://127.0.0.1:9222

# Path B: after MacBook runs tunnel-to-studio.sh, Studio still uses localhost
# (SSH reverse tunnel maps Studio :9222 → MacBook Chrome).
# CDP_URL=http://127.0.0.1:9222

# MLX / model endpoint on Studio (reuse AVA stack when available)
# Prefer OpenAI-compatible mlx_lm.server, or resurrected mlx-think.
MLX_URL=http://127.0.0.1:3211
# Backend: auto | openai | mlx_think
MLX_BACKEND=auto
MLX_MODEL=local

# Agent knobs
MAX_STEPS=20
AGENT_TIMEOUT_S=120
